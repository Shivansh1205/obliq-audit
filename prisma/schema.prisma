generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  // The project is CommonJS (no "type": "module"); the default ESM output
  // leaves model accessors undefined when tsx loads the seed script as CJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

// Tenant root. Every firm-scoped row carries firmId so a query can be
// constrained by it directly, without a join through the parent.
model Firm {
  id      String   @id @default(cuid())
  name    String
  users   User[]
  clients Client[]
  events  AuditEvent[]
}

model User {
  id     String @id @default(cuid())
  firmId String
  name   String
  role   Role

  firm            Firm         @relation(fields: [firmId], references: [id])
  uploads         Document[]   @relation("uploader")
  events          AuditEvent[]
  assignedClients Client[]     @relation("assignment")

  @@index([firmId])
}

enum Role {
  STAFF
  REVIEWER
}

model Client {
  id     String @id @default(cuid())
  firmId String
  name   String

  firm      Firm       @relation(fields: [firmId], references: [id])
  documents Document[]
  // Staff see only the clients assigned to them. Reviewers see the whole
  // firm, so this relation is empty for them.
  assignees User[]     @relation("assignment")

  @@index([firmId])
}

model Document {
  id       String         @id @default(cuid())
  clientId String
  name     String
  status   DocumentStatus @default(PENDING)

  // Set on upload. Null while the document is still PENDING.
  fileName     String?
  uploadedById String?
  uploadedAt   DateTime?

  // Latest reviewer comment. Carries the reason while CORRECTION_REQUIRED.
  reviewComment String?

  client     Client       @relation(fields: [clientId], references: [id])
  uploadedBy User?        @relation("uploader", fields: [uploadedById], references: [id])
  events     AuditEvent[]

  @@index([clientId])
}

enum DocumentStatus {
  PENDING
  UPLOADED
  UNDER_REVIEW
  APPROVED
  CORRECTION_REQUIRED
}

// Append-only. Nothing in the codebase updates or deletes an event.
model AuditEvent {
  id         String      @id @default(cuid())
  firmId     String
  actorId    String
  documentId String
  action     AuditAction
  reason     String?
  createdAt  DateTime    @default(now())

  firm     Firm     @relation(fields: [firmId], references: [id])
  actor    User     @relation(fields: [actorId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@index([firmId, createdAt])
  @@index([documentId, createdAt])
}

enum AuditAction {
  UPLOADED
  REVIEW_STARTED
  CORRECTION_REQUESTED
  APPROVED
  REUPLOADED
}
