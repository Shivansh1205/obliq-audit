# Copy to .env before running: cp .env.example .env

# Postgres. For local development the quickest option is Docker:
#   docker run -d --name obliq-pg -e POSTGRES_PASSWORD=obliq \
#     -e POSTGRES_USER=obliq -e POSTGRES_DB=obliq -p 5433:5432 postgres:16-alpine
DATABASE_URL="postgresql://obliq:obliq@localhost:5433/obliq"

# Optional in development, required in production: lib/session.ts throws
# rather than fall back to a public value when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
